# ===== 数据源配置 =====
# 扶摇金融数据 API（https://fuyao.aicubes.cn/docs/）
FUYAO_API_KEY=
FUYAO_API_URL=https://fuyao.aicubes.cn/api/v1

# iFinD MCP（https://mcp.51ifind.com/）
# 连接信息取自 MCP 配置：url 与 headers.Authorization
# 不配置则文本-数字校验在真实模式下降级（数值/勾稽检查不受影响）
IFIND_MCP_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-mcp
IFIND_MCP_AUTH=

# ===== LLM 配置（OpenAI 兼容接口）=====
# 未配置时产品自动降级为「规则引擎模式」，文本-数字校验不可用并在界面明示
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== 运行模式 =====
# demo：始终使用内置构造数据并明确标注（便于评审演示）
# auto：优先真实接口，失败时降级为演示数据并标注
# real：仅真实接口，失败直接报错（不生成任何结论）
DATA_MODE=auto

# ===== 服务 =====
PORT=8000
